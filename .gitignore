# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv/

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Output (Generated files)
output/videos/*
!output/videos/.gitkeep
output/images/*
!output/images/.gitkeep
output/logs/*
!output/logs/.gitkeep

# Logs (Legacy or root)
logs/*.log
logs/history.json

# Audio (Legacy or root)
audio/*.mp3
audio/*.wav
!audio/.gitkeep

# Public Domain music (keep README if exists)
audio/public_domain/*.mp3
audio/public_domain/*.wav
audio/public_domain/**/*.mp3
audio/public_domain/**/*.wav
!audio/public_domain/README.md
audio/public_domain/catalog.json

# Config (Secrets - exclude these)
token.json
client_secrets.json
data/youtube_client_secret.json

# Config (State tracking - INCLUDE these in Git)
!data/channel_state.json
!data/api_usage.json


# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
/tmp/
